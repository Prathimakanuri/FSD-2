# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cinebook
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/cinebook?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS - Frontend origin
FRONTEND_URL=http://localhost:5173

# TMDB (optional - fallback seeded data used if not set)
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Admin seed (for scripts/seedAdmin.js)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@cinebook.com
ADMIN_PASSWORD=replace_with_strong_password

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
